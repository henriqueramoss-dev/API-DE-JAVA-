{
  "info": {
    "name": "Biblioteca API - Parte 1",
    "description": "Coleção Postman para testar os endpoints da API de Biblioteca.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "perfilId",
      "value": "1"
    },
    {
      "key": "autorId",
      "value": "1"
    },
    {
      "key": "categoriaId",
      "value": "1"
    },
    {
      "key": "livroId",
      "value": "1"
    },
    {
      "key": "emprestimoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Criar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Henrique Ramos\",\n  \"email\": \"henrique@email.com\"\n}"
            },
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios?page=0&size=10"
          }
        },
        {
          "name": "Buscar usuario por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Buscar usuarios por nome",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/buscar?nome=Henrique&page=0&size=10"
          }
        },
        {
          "name": "Atualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Henrique Ramos Atualizado\",\n  \"email\": \"henrique.atualizado@email.com\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Excluir usuario",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        }
      ]
    },
