            },
            "url": "{{baseUrl}}/perfis/{{perfilId}}"
          }
        },
        {
          "name": "Excluir perfil",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/perfis/{{perfilId}}"
